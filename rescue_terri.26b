  ; Build: sh ./build.sh. Build and run in Stella: sh ./run.sh (local VS Code F5).
  ; See AGENTS_RESCUE_TERRI.md for the src/ file guide and compilation order.

  include div_mul.asm
  set romsize 16k

  ; room colors
  const BLACK = $00
  const WHITE = $0E
  const SCORE_COLOR = $2E

  const GRAY_DARK = $04
  const GRAY_LIGHT = $0C

  const GREEN_DARK = $B4
  const GREEN_LIGHT = $B8

  const ORANGE_DARK = $24
  const ORANGE_LIGHT = $28

  const PURPLE_DARK = $54
  const PURPLE_LIGHT = $58

  const GOLD_DARK = $10
  const GOLD_LIGHT = $1E

  const BRICK_DARK = $30
  const BRICK_LIGHT = $3C

  const OLIVE_DARK = $C0
  const OLIVE_LIGHT = $CE

  const TEAL_DARK = $90
  const TEAL_LIGHT = $9C

  ; player colors
  const PINK = $4A
  const BLUE = $84

  ; input debouncing for joystick 0
  dim j0_debounce_up_down = a
  dim j0_debounce_left_right = b

  ; input debouncing for joystick 1
  dim j1_debounce_up_down = c
  dim j1_debounce_left_right = d

  ; current room the missiles are in
  dim mi_room_number = e

  ; a bunch of registeres for dealing with the p1 object
  dim p1_room_number = f

  dim p1_y = g
  dim p1_dx = h
  dim p1_dy = i
  dim p1_move_counter = j

  ; registers for the p0 objective sprite
  dim p0_room_number = k
  dim p0_y = o
  dim game_over = l
  dim color_cycle = m
  dim color_cycle_timer = n
  dim game_state = p
  dim title_bass_duration = q
  dim title_melody_duration = r
  dim title_music_setup_mode = s
  dim title_melody_phrase = t
  dim score_frame_counter = y
  dim easter_egg_found = z

  ; initialize the first room
  mi_room_number = 0

  const ROOM_RIGHT = 1
  const ROOM_MIDDLE = 2
  const ROOM_LEFT = 3
  const ROOM_TOP = 4
  const ROOM_BOTTOM = 5
  const ROOM_TOP_RIGHT = 6
  const ROOM_TOP_LEFT = 7
  const ROOM_BOTTOM_LEFT = 8
  const ROOM_BOTTOM_RIGHT = 9
  const ROOM_HIDDEN = 10
  const TEMPLE_BALL_X = 41
  const TEMPLE_BALL_Y = 53
  const TEMPLE_BALL_VISIBLE_FRAMES = 45
  const STATE_TITLE = 0
  const STATE_PLAY = 1
  const TITLE_MUSIC_SETUP_INIT = 0
  const TITLE_MUSIC_SETUP_MELODY = 1
  const TITLE_MUSIC_SETUP_BASS = 2

  ; missle screen offset
  const SCR_LEFT_X = 18
  const SCR_RIGHT_X = 142
  const SCR_TOP_Y = 4
  const SCR_BOT_Y = 87
  const OFFSCRN_Y = 200
  ; BLUE
  const START_M0_X = 100
  const START_M0_Y = 65
  ; PINK
  const START_M1_X = 100
  const START_M1_Y = 25
  
  ; TERRI
  const START_P1_X = 99
  const START_P1_Y = 45
  const TITLE_SCREEN_P1_X = 113
  const TITLE_SCREEN_P1_Y = 52

  ; HOUSE
  const START_P0_X = 127
  const START_P0_Y = 75
  const TITLE_SCREEN_P0_X = 111
  const TITLE_SCREEN_P0_Y = 53

  ; exact player1 anchor point that lands inside the house opening
  const HOUSE_ENTRY_X = 129
  const HOUSE_ENTRY_Y = 74

  const ENTRY_GATE_LEFT_X = 22
  const ENTRY_GATE_RIGHT_X = 138
  const ENTRY_GATE_TOP_Y = 8
  const ENTRY_GATE_BOT_Y = 79

  ; missile dimensions (defined first, used in collision constants)
  const MISSLE_WIDTH = 4
  const MISSLE_HEIGHT = 4
  const MISSLE_WIDTH_BIN = %00100000

  ; horizontal offset
  const PF_SCR_X_OFFSET = 18

  ; optimized X collision constants (same for both missiles)
  const M_X_LEFT_EDGE = PF_SCR_X_OFFSET + 1          ; = 19
  const M_X_RIGHT_EDGE = PF_SCR_X_OFFSET - MISSLE_WIDTH + 1  ; = 15
  const M_X_RIGHT_EDGE_PLUS1 = M_X_RIGHT_EDGE - 1    ; = 14

  ; vertical offset
  const PF_SCR_Y_OFFSET = 3

  ; optimized Y collision constants
  const M0_Y_TOP_EDGE = PF_SCR_Y_OFFSET + 1        ; = 4
  const M0_Y_BOTTOM_EDGE = PF_SCR_Y_OFFSET - MISSLE_HEIGHT  ; = -1 (will add to missiley)
  const M0_Y_BOTTOM_EDGE_MINUS1 = M0_Y_BOTTOM_EDGE + 1       ; = 0
  const M1_Y_TOP_EDGE = PF_SCR_Y_OFFSET + 2        ; = 5
  const M1_Y_TOP_EDGE_MINUS1 = PF_SCR_Y_OFFSET + 1 ; = 4
  const M1_Y_BOTTOM_EDGE_MINUS1 = PF_SCR_Y_OFFSET - MISSLE_HEIGHT + 1  ; = 0
  const M1_Y_BOTTOM_EDGE_MINUS2 = PF_SCR_Y_OFFSET - MISSLE_HEIGHT + 2  ; = 1

  ; missle 0 setup
  COLUP0 = BLUE
  missile0height = MISSLE_HEIGHT - 1
  missile0x = START_M0_X
  missile0y = START_M0_Y

  ; missle 1 setup
  COLUP1 = PINK
  missile1height = MISSLE_HEIGHT - 1
  missile1x = START_M1_X
  missile1y = START_M1_Y

  ; reflect the playfield and use a narrower ball width
  CTRLPF = $11

  ; temple easter egg ball
  ballx = TEMPLE_BALL_X
  bally = OFFSCRN_Y
  ballheight = 1

  ; frames to wait before auto-repeat
  const J_DEBOUNCE_DELAY = 4

  ; a bunch of p1 constants
  ; elapsed frames between player1 movements towards the midpoint
  const P1_MOVE_DELAY = 3
  const P1_GATE_THRESHOLD = 2 ; how close the p1 sprite is to the gate to pass through
  const COLOR_CYCLE_DELAY = 12
  const SCORE_FRAMES_PER_SECOND = 60

  p1_move_counter = 0

  player1:
    %11110000
    %10010000
    %10010000
    %11110000
end
  player1x = TITLE_SCREEN_P1_X
  player1y = TITLE_SCREEN_P1_Y

  ; p1 starts in room 1
  p1_room_number = ROOM_RIGHT

  player0:
    %11111111
    %01000010
    %01011010
    %01011010
    %01000010
    %11111111
    %01111110
    %00110000
end
  player0x = TITLE_SCREEN_P0_X
  player0y = TITLE_SCREEN_P0_Y
  p0_y = player0y

  ; p0 starts in room 1
  p0_room_number = ROOM_RIGHT
  game_over = 0
  color_cycle = 0
  color_cycle_timer = 0
  game_state = STATE_TITLE
  score = 0
  score_frame_counter = 0
  scorecolor = BLACK
  missile0y = OFFSCRN_Y
  missile1y = OFFSCRN_Y
  goto _title_screen
