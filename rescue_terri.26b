_game_over_melody_ready
  title_melody_duration = 1
  if title_music_setup_mode = TITLE_MUSIC_SETUP_INIT then goto _game_over
  goto _read_title_melody_event

_room_right_boundary_check
  if missile0x <= SCR_LEFT_X && missile1x <= SCR_LEFT_X then goto _room_middle bank2
  if missile0y >= SCR_BOT_Y && missile1y >= SCR_BOT_Y then goto _room_bottom_right bank2
  goto _end_boundary_check
_skip_room_right_boundary_check

_room_middle_boundary_check
  if missile0x >= SCR_RIGHT_X && missile1x >= SCR_RIGHT_X then goto _room_right bank2
  if missile0x <= SCR_LEFT_X && missile1x <= SCR_LEFT_X then goto _room_left bank2
  if missile0y <= SCR_TOP_Y && missile1y <= SCR_TOP_Y then goto _room_top bank2
  if missile0y >= SCR_BOT_Y && missile1y >= SCR_BOT_Y then goto _room_bottom bank2
  goto _end_boundary_check
_skip_room_middle_boundary_check

_room_left_boundary_check
  if missile0y <= SCR_TOP_Y && missile1y <= SCR_TOP_Y then goto _room_top_left bank2
  if missile0x >= SCR_RIGHT_X && missile1x >= SCR_RIGHT_X then goto _room_middle bank2
  goto _end_boundary_check
_skip_room_left_boundary_check

_room_top_boundary_check
  if missile0x <= SCR_LEFT_X && missile1x <= SCR_LEFT_X then goto _room_top_left bank2
  if missile0x >= SCR_RIGHT_X && missile1x >= SCR_RIGHT_X then goto _room_top_right bank2
  if missile0y >= SCR_BOT_Y && missile1y >= SCR_BOT_Y then goto _room_middle bank2
  goto _end_boundary_check
_skip_room_top_boundary_check

_room_bottom_boundary_check
  if missile0x <= SCR_LEFT_X && missile1x <= SCR_LEFT_X then goto _room_bottom_left bank2
  if missile0x >= SCR_RIGHT_X && missile1x >= SCR_RIGHT_X then goto _room_bottom_right bank2
  if missile0y <= SCR_TOP_Y && missile1y <= SCR_TOP_Y then goto _room_middle bank2
  goto _end_boundary_check
_skip_room_bottom_boundary_check

_room_top_right_boundary_check
  if missile0x <= SCR_LEFT_X && missile1x <= SCR_LEFT_X then goto _room_top bank2
  goto _end_boundary_check
_skip_room_top_right_boundary_check

_room_top_left_boundary_check
  if missile0x >= SCR_RIGHT_X && missile1x >= SCR_RIGHT_X then goto _room_top bank2
  if missile0y >= SCR_BOT_Y && missile1y >= SCR_BOT_Y then goto _room_left bank2
  goto _end_boundary_check
_skip_room_top_left_boundary_check

_room_bottom_left_boundary_check
  if missile0x >= SCR_RIGHT_X && missile1x >= SCR_RIGHT_X then goto _room_bottom bank2
  goto _end_boundary_check
_skip_room_bottom_left_boundary_check

_room_bottom_right_boundary_check
  if missile0x <= SCR_LEFT_X && missile1x <= SCR_LEFT_X then goto _room_bottom bank2
  if missile0y <= SCR_TOP_Y && missile1y <= SCR_TOP_Y then goto _room_right bank2
  goto _end_boundary_check
_skip_room_bottom_right_boundary_check

 bank 2

  dim p1_gate_transfer = temp1

  ; Room playfields are 32 columns by 11 rows. X = wall, . = open floor.

_room_right
  if mi_room_number = ROOM_MIDDLE then missile0x = ENTRY_GATE_LEFT_X
  if mi_room_number = ROOM_MIDDLE then missile1x = ENTRY_GATE_LEFT_X
  p1_gate_transfer = 0
  if mi_room_number = ROOM_MIDDLE && p1_room_number = ROOM_MIDDLE && player1y <> OFFSCRN_Y && player1x >= ENTRY_GATE_RIGHT_X then p1_gate_transfer = 1
  if p1_gate_transfer then player1x = ENTRY_GATE_LEFT_X + P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_RIGHT
  if mi_room_number = ROOM_BOTTOM_RIGHT then missile0y = ENTRY_GATE_BOT_Y
  if mi_room_number = ROOM_BOTTOM_RIGHT then missile1y = ENTRY_GATE_BOT_Y
  p1_gate_transfer = 0
  if mi_room_number = ROOM_BOTTOM_RIGHT && p1_room_number = ROOM_BOTTOM_RIGHT && player1y <> OFFSCRN_Y && player1y <= ENTRY_GATE_TOP_Y + P1_GATE_THRESHOLD then p1_gate_transfer = 1
  if p1_gate_transfer then player1y = ENTRY_GATE_BOT_Y - P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_RIGHT
_inititial_game_room
  mi_room_number = ROOM_RIGHT
  COLUBK = BLACK
  COLUPF = WHITE
  playfield:
    XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
    ...............................X
    ...............................X
    ...............................X
    XXXXXXXXXXXXXXXXXXXXXXXX.......X
    .......................X.......X
    XXXXXXXXXXXXXXXXXXXXXXXX.......X
    .........................XXXXXXX
    .........................X.....X
    .........................X.....X
    XXXXXXXXXXXXXXXXXXXXXXXXXX.X.X.X
end
  goto _end_boundary_check bank1

_room_middle
  ; depending on which room we came from
  ; set the correct horizonal or vertical starting position
  if mi_room_number = ROOM_RIGHT then missile0x = ENTRY_GATE_RIGHT_X
  if mi_room_number = ROOM_RIGHT then missile1x = ENTRY_GATE_RIGHT_X
  p1_gate_transfer = 0
  if mi_room_number = ROOM_RIGHT && p1_room_number = ROOM_RIGHT && player1y <> OFFSCRN_Y && player1x <= ENTRY_GATE_LEFT_X - P1_GATE_THRESHOLD then p1_gate_transfer = 1
  if p1_gate_transfer then player1x = ENTRY_GATE_RIGHT_X - P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_MIDDLE
  if mi_room_number = ROOM_LEFT then missile0x = ENTRY_GATE_LEFT_X
  if mi_room_number = ROOM_LEFT then missile1x = ENTRY_GATE_LEFT_X
  p1_gate_transfer = 0
  if mi_room_number = ROOM_LEFT && p1_room_number = ROOM_LEFT && player1y <> OFFSCRN_Y && player1x >= ENTRY_GATE_RIGHT_X then p1_gate_transfer = 1
  if p1_gate_transfer then player1x = ENTRY_GATE_LEFT_X + P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_MIDDLE
  if mi_room_number = ROOM_TOP then missile0y = ENTRY_GATE_TOP_Y
  if mi_room_number = ROOM_TOP then missile1y = ENTRY_GATE_TOP_Y
  p1_gate_transfer = 0
  if mi_room_number = ROOM_TOP && p1_room_number = ROOM_TOP && player1y <> OFFSCRN_Y && player1y >= ENTRY_GATE_BOT_Y + P1_GATE_THRESHOLD then p1_gate_transfer = 1
  if p1_gate_transfer then player1y = ENTRY_GATE_TOP_Y + P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_MIDDLE
  if mi_room_number = ROOM_BOTTOM then missile0y = ENTRY_GATE_BOT_Y
  if mi_room_number = ROOM_BOTTOM then missile1y = ENTRY_GATE_BOT_Y
  p1_gate_transfer = 0
  if mi_room_number = ROOM_BOTTOM && p1_room_number = ROOM_BOTTOM && player1y <> OFFSCRN_Y && player1y <= ENTRY_GATE_TOP_Y + P1_GATE_THRESHOLD then p1_gate_transfer = 1
  if p1_gate_transfer then player1y = ENTRY_GATE_BOT_Y - P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_MIDDLE
  mi_room_number = ROOM_MIDDLE
  COLUBK = ORANGE_DARK
  COLUPF = ORANGE_LIGHT
  playfield:
    XXXXXXXXXXXXXX..X..X..XXXXXXXXXX
    X............X..X..X............
    .............X..X..X............
    XXXXXXXXXXXX.X..X..X............
    X..........X.X..X..X.....XXXXXXX
    X..........X.X..X..X.....X......
    ...........X.X..X..XXXXXXX..XXXX
    XXXX.......X.X..X...........X...
    ...X.......X.X..XXXXXXXXXXXXX...
    X..X.......X.X..................
    X..XX.....XX.XXXXXXXXXXXXXXXXXXX
end
  goto _end_boundary_check bank1

_room_left
  if mi_room_number = ROOM_MIDDLE then missile0x = ENTRY_GATE_RIGHT_X
  if mi_room_number = ROOM_MIDDLE then missile1x = ENTRY_GATE_RIGHT_X
  p1_gate_transfer = 0
  if mi_room_number = ROOM_MIDDLE && p1_room_number = ROOM_MIDDLE && player1y <> OFFSCRN_Y && player1x <= ENTRY_GATE_LEFT_X - P1_GATE_THRESHOLD then p1_gate_transfer = 1
  if p1_gate_transfer then player1x = ENTRY_GATE_RIGHT_X - P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_LEFT
  if mi_room_number = ROOM_TOP_LEFT then missile0y = ENTRY_GATE_TOP_Y
  if mi_room_number = ROOM_TOP_LEFT then missile1y = ENTRY_GATE_TOP_Y
  p1_gate_transfer = 0
  if mi_room_number = ROOM_TOP_LEFT && p1_room_number = ROOM_TOP_LEFT && player1y <> OFFSCRN_Y && player1y >= ENTRY_GATE_BOT_Y + P1_GATE_THRESHOLD then p1_gate_transfer = 1
  if p1_gate_transfer then player1y = ENTRY_GATE_TOP_Y + P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_LEFT
  mi_room_number = ROOM_LEFT
