  if p1_gate_transfer then player1x = ENTRY_GATE_RIGHT_X - P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_BOTTOM_LEFT
  mi_room_number = ROOM_BOTTOM_LEFT
  COLUBK = OLIVE_DARK
  COLUPF = OLIVE_LIGHT
