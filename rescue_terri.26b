  16
  8,4,31
  16
  8,4,26
  16
  8,4,29
  16
  8,4,26
  16
  8,4,31
  32
  255
end
  title_melody_duration = 1
  if title_music_setup_mode = TITLE_MUSIC_SETUP_INIT then goto mainloop
  goto _read_title_melody_event

