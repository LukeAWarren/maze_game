  include div_mul.asm
  set romsize 8k

  ; room colors
  const BLACK = $00
  const WHITE = $0E
  const SCORE_COLOR = $2E

  const GRAY_DARK = $04
  const GRAY_LIGHT = $0C

  const GREEN_DARK = $B4
  const GREEN_LIGHT = $B8

  const ORANGE_DARK = $24
  const ORANGE_LIGHT = $28

  const PURPLE_DARK = $54
  const PURPLE_LIGHT = $58

  const GOLD_DARK = $10
  const GOLD_LIGHT = $1E

  const BRICK_DARK = $30
  const BRICK_LIGHT = $3C

  const OLIVE_DARK = $C0
  const OLIVE_LIGHT = $CE

  const TEAL_DARK = $90
  const TEAL_LIGHT = $9C

  ; player colors
  const PINK = $4A
  const BLUE = $84

  ; input debouncing for joystick 0
  dim j0_debounce_up_down = a
  dim j0_debounce_left_right = b

  ; input debouncing for joystick 1
  dim j1_debounce_up_down = c
  dim j1_debounce_left_right = d

  ; current room the missiles are in
  dim mi_room_number = e

  ; a bunch of registeres for dealing with the p1 object
  dim p1_room_number = f

  dim p1_y = g
  dim p1_dx = h
  dim p1_dy = i
  dim p1_move_counter = j

  ; registers for the p0 objective sprite
  dim p0_room_number = k
  dim p0_y = o
  dim game_over = l
  dim color_cycle = m
  dim color_cycle_timer = n
  dim game_state = p
  dim title_bass_duration = q
  dim title_melody_duration = r
  dim title_music_setup_mode = s
  dim title_melody_phrase = t
  dim score_frame_counter = y
  dim easter_egg_found = z

  ; initialize the first room
  mi_room_number = 0

  const ROOM_RIGHT = 1
  const ROOM_MIDDLE = 2
  const ROOM_LEFT = 3
  const ROOM_TOP = 4
  const ROOM_BOTTOM = 5
  const ROOM_TOP_RIGHT = 6
  const ROOM_TOP_LEFT = 7
  const ROOM_BOTTOM_LEFT = 8
  const ROOM_BOTTOM_RIGHT = 9
  const TEMPLE_BALL_X = 41
  const TEMPLE_BALL_Y = 53
  const STATE_TITLE = 0
  const STATE_PLAY = 1
  const TITLE_MUSIC_SETUP_INIT = 0
  const TITLE_MUSIC_SETUP_MELODY = 1
  const TITLE_MUSIC_SETUP_BASS = 2

  ; missle screen offset
  const SCR_LEFT_X = 18
  const SCR_RIGHT_X = 142
  const SCR_TOP_Y = 4
  const SCR_BOT_Y = 87
  const OFFSCRN_Y = 200
  ; BLUE
  const START_M0_X = 100
  const START_M0_Y = 65
  ; PINK
  const START_M1_X = 100
  const START_M1_Y = 25
  
  ; TERRI
  const START_P1_X = 99
  const START_P1_Y = 45
  const TITLE_SCREEN_P1_X = 113
  const TITLE_SCREEN_P1_Y = 52

  ; HOUSE
  const START_P0_X = 127
  const START_P0_Y = 75
  const TITLE_SCREEN_P0_X = 111
  const TITLE_SCREEN_P0_Y = 53

  ; exact player1 anchor point that lands inside the house opening
  const HOUSE_ENTRY_X = 129
  const HOUSE_ENTRY_Y = 74

  const ENTRY_GATE_LEFT_X = 22
  const ENTRY_GATE_RIGHT_X = 138
  const ENTRY_GATE_TOP_Y = 8
  const ENTRY_GATE_BOT_Y = 79

  ; missile dimensions (defined first, used in collision constants)
  const MISSLE_WIDTH = 4
  const MISSLE_HEIGHT = 4
  const MISSLE_WIDTH_BIN = %00100000

  ; horizontal offset
  const PF_SCR_X_OFFSET = 18

  ; optimized X collision constants (same for both missiles)
  const M_X_LEFT_EDGE = PF_SCR_X_OFFSET + 1          ; = 19
  const M_X_RIGHT_EDGE = PF_SCR_X_OFFSET - MISSLE_WIDTH + 1  ; = 15
  const M_X_RIGHT_EDGE_PLUS1 = M_X_RIGHT_EDGE - 1    ; = 14

  ; vertical offset
  const PF_SCR_Y_OFFSET = 3

  ; optimized Y collision constants
  const M0_Y_TOP_EDGE = PF_SCR_Y_OFFSET + 1        ; = 4
  const M0_Y_BOTTOM_EDGE = PF_SCR_Y_OFFSET - MISSLE_HEIGHT  ; = -1 (will add to missiley)
  const M0_Y_BOTTOM_EDGE_MINUS1 = M0_Y_BOTTOM_EDGE + 1       ; = 0
  const M1_Y_TOP_EDGE = PF_SCR_Y_OFFSET + 2        ; = 5
  const M1_Y_TOP_EDGE_MINUS1 = PF_SCR_Y_OFFSET + 1 ; = 4
  const M1_Y_BOTTOM_EDGE_MINUS1 = PF_SCR_Y_OFFSET - MISSLE_HEIGHT + 1  ; = 0
  const M1_Y_BOTTOM_EDGE_MINUS2 = PF_SCR_Y_OFFSET - MISSLE_HEIGHT + 2  ; = 1

  ; missle 0 setup
  COLUP0 = BLUE
  missile0height = MISSLE_HEIGHT - 1
  missile0x = START_M0_X
  missile0y = START_M0_Y

  ; missle 1 setup
  COLUP1 = PINK
  missile1height = MISSLE_HEIGHT - 1
  missile1x = START_M1_X
  missile1y = START_M1_Y

  ; reflect the playfield and use a narrower ball width
  CTRLPF = $11

  ; temple easter egg ball
  ballx = TEMPLE_BALL_X
  bally = OFFSCRN_Y
  ballheight = 1

  ; frames to wait before auto-repeat
  const J_DEBOUNCE_DELAY = 4

  ; a bunch of p1 constants
  ; elapsed frames between player1 movements towards the midpoint
  const P1_MOVE_DELAY = 3
  const P1_GATE_THRESHOLD = 2 ; how close the p1 sprite is to the gate to pass through
  const COLOR_CYCLE_DELAY = 12
  const SCORE_FRAMES_PER_SECOND = 60

  p1_move_counter = 0

  player1:
    %11110000
    %10010000
    %10010000
    %11110000
end
  player1x = TITLE_SCREEN_P1_X
  player1y = TITLE_SCREEN_P1_Y

  ; p1 starts in room 1
  p1_room_number = ROOM_RIGHT

  player0:
    %11111111
    %01000010
    %01011010
    %01011010
    %01000010
    %11111111
    %01111110
    %00110000
end
  player0x = TITLE_SCREEN_P0_X
  player0y = TITLE_SCREEN_P0_Y
  p0_y = player0y

  ; p0 starts in room 1
  p0_room_number = ROOM_RIGHT
  game_over = 0
  color_cycle = 0
  color_cycle_timer = 0
  game_state = STATE_TITLE
  score = 0
  score_frame_counter = 0
  scorecolor = BLACK
  missile0y = OFFSCRN_Y
  missile1y = OFFSCRN_Y
  goto _title_screen

mainloop
  ; Console Reset is the 2600 start/reset button.
  if switchreset then reboot
  if game_state = STATE_TITLE then goto _title_loop
  NUSIZ0 = MISSLE_WIDTH_BIN ; four pixels wide
  NUSIZ1 = MISSLE_WIDTH_BIN ; four pixels wide
  if game_over then goto _game_over

  ; use these two temps vars for all the missile playfield collision detection
  dim coll_detect_x = temp3
  dim coll_detect_y = temp4

  if !joy0up && !joy0down then j0_debounce_up_down = 0

j0_up

  ; the joy up is not pressed then always set debounce counter 0
  if !joy0up then goto skip_j0_up

    if missile0y <= SCR_TOP_Y then goto skip_j0_up

      ; calculate top y pos
      coll_detect_y = ((missile0y - M0_Y_TOP_EDGE) / 8)

      ; get the left x pos
      coll_detect_x = ((missile0x - PF_SCR_X_OFFSET) / 4)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j0_up

      ; get the right x pos
      coll_detect_x = ((missile0x - M_X_RIGHT_EDGE) / 4)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j0_up

      if j0_debounce_up_down = 0 || j0_debounce_up_down > J_DEBOUNCE_DELAY then missile0y = missile0y - 1

      j0_debounce_up_down = j0_debounce_up_down + 1

skip_j0_up

j0_down
  if !joy0down goto skip_j0_down

    if missile0y >= SCR_BOT_Y then goto skip_j0_down

      ; calculate bottom y pos
      coll_detect_y = ((missile0y - M0_Y_BOTTOM_EDGE) / 8)

      ; get the right x pos
      coll_detect_x = ((missile0x - M_X_RIGHT_EDGE) / 4)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j0_down

      ; get the left x pos
      coll_detect_x = ((missile0x - PF_SCR_X_OFFSET) / 4)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j0_down

      if j0_debounce_up_down = 0 || j0_debounce_up_down > J_DEBOUNCE_DELAY then missile0y = missile0y + 1

      j0_debounce_up_down = j0_debounce_up_down + 1

skip_j0_down

  if !joy0left && !joy0right then j0_debounce_left_right = 0

j0_left
  if !joy0left goto skip_j0_left

    if missile0x <= SCR_LEFT_X then goto skip_j0_left
      ; get the left x
      coll_detect_x = ((missile0x - M_X_LEFT_EDGE) / 4)

      ; get the top y
      coll_detect_y = ((missile0y - PF_SCR_Y_OFFSET) / 8)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j0_left

      ; get the bottom y
      coll_detect_y = ((missile0y - M0_Y_BOTTOM_EDGE_MINUS1) / 8)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j0_left

      if j0_debounce_left_right = 0 || j0_debounce_left_right > J_DEBOUNCE_DELAY then missile0x = missile0x - 1

      j0_debounce_left_right = j0_debounce_left_right + 1

skip_j0_left

j0_right
  if !joy0right goto skip_j0_right

    if missile0x >= SCR_RIGHT_X then goto skip_j0_right
      ; get the right x
      coll_detect_x = ((missile0x - M_X_RIGHT_EDGE_PLUS1) / 4)

      ; get the top y
      coll_detect_y = ((missile0y - PF_SCR_Y_OFFSET) / 8)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j0_right

      ; get the bottom y
      coll_detect_y = ((missile0y - M0_Y_BOTTOM_EDGE_MINUS1) / 8)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j0_right

      if j0_debounce_left_right = 0 || j0_debounce_left_right > J_DEBOUNCE_DELAY then missile0x = missile0x + 1

      j0_debounce_left_right = j0_debounce_left_right + 1

skip_j0_right

  if !joy1up && !joy1down then j1_debounce_up_down = 0

j1_up
  if !joy1up goto skip_j1_up

    if missile1y <= SCR_TOP_Y then goto skip_j1_up

      ; calculate top y pos
      coll_detect_y = ((missile1y - M1_Y_TOP_EDGE) / 8)

      ; get the left x pos
      coll_detect_x = ((missile1x - PF_SCR_X_OFFSET) / 4)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j1_up

      ; get the right x pos
      coll_detect_x = ((missile1x - M_X_RIGHT_EDGE) / 4)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j1_up

      if j1_debounce_up_down = 0 || j1_debounce_up_down > J_DEBOUNCE_DELAY then missile1y = missile1y - 1

      j1_debounce_up_down = j1_debounce_up_down + 1

skip_j1_up

j1_down
  if !joy1down goto skip_j1_down

    if missile1y >= SCR_BOT_Y then goto skip_j1_down

      ; calculate bottom y pos
      coll_detect_y = ((missile1y - M1_Y_BOTTOM_EDGE_MINUS1) / 8)

      ; get the right x pos
      coll_detect_x = ((missile1x - M_X_RIGHT_EDGE) / 4)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j1_down

      ; get the left x pos
      coll_detect_x = ((missile1x - PF_SCR_X_OFFSET) / 4)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j1_down

      if j1_debounce_up_down = 0 || j1_debounce_up_down > J_DEBOUNCE_DELAY then missile1y = missile1y + 1

      j1_debounce_up_down = j1_debounce_up_down + 1

skip_j1_down

  if !joy1left && !joy1right then j1_debounce_left_right = 0

j1_left
  if !joy1left goto skip_j1_left
    if missile1x <= SCR_LEFT_X then goto skip_j1_left
      ; get the left x
      coll_detect_x = ((missile1x - M_X_LEFT_EDGE) / 4)

      ; get the top y
      coll_detect_y = ((missile1y - M1_Y_TOP_EDGE_MINUS1) / 8)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j1_left

      ; get the bottom y
      coll_detect_y = ((missile1y - M1_Y_BOTTOM_EDGE_MINUS2) / 8)
      if pfread(coll_detect_x, coll_detect_y) then goto skip_j1_left

      if j1_debounce_left_right = 0 || j1_debounce_left_right > J_DEBOUNCE_DELAY then missile1x = missile1x - 1

      j1_debounce_left_right = j1_debounce_left_right + 1

skip_j1_left

j1_right
  if !joy1right goto skip_j1_right

    if missile1x >= SCR_RIGHT_X then goto skip_j1_right
      ; get the right x
      coll_detect_x = ((missile1x - M_X_RIGHT_EDGE_PLUS1) / 4)

      ; get the top y
      coll_detect_y = ((missile1y - M1_Y_TOP_EDGE_MINUS1) / 8)
      if pfread(coll_detect_x,coll_detect_y) then goto skip_j1_right

      ; get the bottom y
      coll_detect_y = ((missile1y - M1_Y_BOTTOM_EDGE_MINUS2) / 8)
      if pfread(coll_detect_x,coll_detect_y) then goto skip_j1_right

      if j1_debounce_left_right = 0 || j1_debounce_left_right > J_DEBOUNCE_DELAY then missile1x = missile1x + 1

      j1_debounce_left_right = j1_debounce_left_right + 1

skip_j1_right

_begin_boundary_check

  if mi_room_number = 0 then goto _inititial_game_room bank2
  if mi_room_number = ROOM_RIGHT then goto _room_right_boundary_check
  if mi_room_number = ROOM_MIDDLE then goto _room_middle_boundary_check
  if mi_room_number = ROOM_LEFT then goto _room_left_boundary_check
  if mi_room_number = ROOM_TOP then goto _room_top_boundary_check
  if mi_room_number = ROOM_BOTTOM then goto _room_bottom_boundary_check
  if mi_room_number = ROOM_TOP_RIGHT then goto _room_top_right_boundary_check
  if mi_room_number = ROOM_TOP_LEFT then goto _room_top_left_boundary_check
  if mi_room_number = ROOM_BOTTOM_LEFT then goto _room_bottom_left_boundary_check
  if mi_room_number = ROOM_BOTTOM_RIGHT then goto _room_bottom_right_boundary_check

_end_boundary_check

  if mi_room_number = ROOM_BOTTOM_LEFT then bally = TEMPLE_BALL_Y else bally = OFFSCRN_Y

_begin_p0_logic
  if p0_room_number = mi_room_number && player0y = OFFSCRN_Y then goto _restore_pos_p0
  if p0_room_number <> mi_room_number && player0y <> OFFSCRN_Y then goto _save_and_hide_p0
  goto _end_p0_logic

_save_and_hide_p0
  p0_y = player0y
  player0y = OFFSCRN_Y
  goto _end_p0_logic
_restore_pos_p0
  player0y = p0_y
_end_p0_logic

_begin_p1_logic

  ; if p1 is in the room but is off the screen, then restore its last y position
  if p1_room_number = mi_room_number && player1y = OFFSCRN_Y then goto _restore_pos_and_move_p1
  ; if p1 is in the same room as the missiles and it's currently on the screen
  ; then calculate a new position for p1
  if p1_room_number = mi_room_number && player1y <> OFFSCRN_Y then goto _calc_pos_and_move_p1
  ; if the missiles are not in the room with the player
  ; but the player is visible then hide it
  if p1_room_number <> mi_room_number && player1y <> OFFSCRN_Y then goto _save_and_hide_p1
  ; if the missiles are not in the room with the player
  ; and the player is already offscreen don't do anything
  if p1_room_number <> mi_room_number && player1y = OFFSCRN_Y then goto _end_p1_logic

_save_and_hide_p1
  p1_y = player1y
  player1y = OFFSCRN_Y
  p1_move_counter = 0
  goto _end_p1_logic
_restore_pos_and_move_p1
  ; if p1_room_number = mi_room_number && player1y = OFFSCRN_Y then player1y = p1_y
  player1y = p1_y
_calc_pos_and_move_p1
  ; calculate midpoint between m0 and m1

  dim mid_delta = temp3
  dim mid_delta_half = temp4
  dim mx_mid = temp5
  dim my_mid = temp6

  ; calculate horizontal midpoint
  if missile0x > missile1x then goto _m0_x_right_of_m1_x
    mid_delta = missile1x - missile0x
    mid_delta_half = mid_delta / 2
    mx_mid = missile1x - mid_delta_half
    mx_mid = mx_mid - 1
    goto _end_m0_m1_horizontal_midpoint
_m0_x_right_of_m1_x
  mid_delta = missile0x - missile1x
  mid_delta_half = mid_delta / 2
  mx_mid = missile0x - mid_delta_half
  mx_mid = mx_mid - 1
_end_m0_m1_horizontal_midpoint

  ; calculate vertical midpoint
  if missile0y > missile1y then goto _m0_y_right_of_m1_y
    mid_delta = missile1y - missile0y
    mid_delta_half = mid_delta / 2
    my_mid = missile1y - mid_delta_half
    goto _end_m0_m1_vertical_midpoint
_m0_y_right_of_m1_y
  mid_delta = missile0y - missile1y
  mid_delta_half = mid_delta / 2
  my_mid = missile0y - mid_delta_half
_end_m0_m1_vertical_midpoint

  ; only step every P1_MOVE_DELAY frames
  p1_move_counter = p1_move_counter + 1
  if p1_move_counter <= P1_MOVE_DELAY then goto _end_p1_logic
  p1_move_counter = 0

  ; the p1 sprite is already at the midpoint of the two missile sprites
  if player1x = mx_mid && player1y = my_mid then goto _end_p1_logic

  ; determine which direction p1 should move
  if player1x = mx_mid then p1_dx = 0 : goto _end_set_p1_dx
  if player1x < mx_mid then p1_dx = 1 else p1_dx = -1
_end_set_p1_dx

  if player1y = my_mid then p1_dy = 0 : goto _end_set_p1_dy
  if player1y < my_mid then p1_dy = 1 else p1_dy = -1
_end_set_p1_dy


  dim coll_detect_top = temp3
  dim coll_detect_bottom = temp4
  dim coll_detect_right = temp5
  dim coll_detect_left = temp6

_begin_p1_up
  if p1_dy <> -1 then goto _end_p1_up
    coll_detect_top = ((player1y - 5) / 8)
    coll_detect_left = ((player1x - 17) / 4)
    if pfread(coll_detect_left, coll_detect_top) then goto _end_p1_up
      coll_detect_right = ((player1x - 14) / 4)
    if pfread(coll_detect_right, coll_detect_top) then goto _end_p1_up
    player1y = player1y - 1
_end_p1_up

_begin_p1_down
  if p1_dy <> 1 then goto _end_p1_down
    coll_detect_bottom = (player1y / 8)
    coll_detect_left = ((player1x - 17) / 4)
    if pfread(coll_detect_left, coll_detect_bottom) then goto _end_p1_down
      coll_detect_right = ((player1x - 14) / 4)
    if pfread(coll_detect_right, coll_detect_bottom) then goto _end_p1_down
    player1y = player1y + 1
_end_p1_down

_begin_p1_right
  if p1_dx <> 1 then goto _end_p1_right
    coll_detect_right = ((player1x - 13) / 4)
    coll_detect_top = ((player1y - 4) / 8)
    if pfread(coll_detect_right, coll_detect_top) then goto _end_p1_right
      coll_detect_bottom = ((player1y - 1) / 8)
    if pfread(coll_detect_right, coll_detect_bottom) then goto _end_p1_right
    player1x = player1x + 1
_end_p1_right

_begin_p1_left
  if p1_dx <> -1 then goto _end_p1_left
    coll_detect_left = ((player1x - 18) / 4)
    coll_detect_top = ((player1y - 4) / 8)
    if pfread(coll_detect_left, coll_detect_top) then goto _end_p1_left
      coll_detect_bottom = ((player1y - 1) / 8)
    if pfread(coll_detect_left, coll_detect_bottom) then goto _end_p1_left
    player1x = player1x - 1
_end_p1_left

_end_p1_logic

_update_score_timer
  score_frame_counter = score_frame_counter + 1
  if score_frame_counter < SCORE_FRAMES_PER_SECOND then goto _end_score_timer
  score_frame_counter = 0
  score = score + 1
_end_score_timer

  if p1_room_number = ROOM_BOTTOM_LEFT && player1x <= TEMPLE_BALL_X && player1x >= TEMPLE_BALL_X - 3 && player1y <= TEMPLE_BALL_Y && player1y >= TEMPLE_BALL_Y - 3 then goto _start_easter_egg
  if p0_room_number = p1_room_number && player1x = HOUSE_ENTRY_X && player1y = HOUSE_ENTRY_Y then goto _start_game_over

  COLUP0 = BLUE
  COLUP1 = PINK
  drawscreen
  goto mainloop

_start_easter_egg
  easter_egg_found = 1
  bally = OFFSCRN_Y
  player1:
    %01100000
    %11110000
    %11110000
    %01100000
end
  goto _start_game_over

_start_game_over
  game_over = 1
  color_cycle = 0
  color_cycle_timer = 0
  title_music_setup_mode = TITLE_MUSIC_SETUP_INIT
  goto _title_bass_setup

_game_over
  if color_cycle_timer < COLOR_CYCLE_DELAY then color_cycle_timer = color_cycle_timer + 1 : goto _game_over_colors
  color_cycle_timer = 0
  color_cycle = color_cycle + 1
  if color_cycle > 8 then color_cycle = 0

_game_over_colors
  if color_cycle = 0 then COLUBK = BLACK : COLUPF = WHITE
  if color_cycle = 1 then COLUBK = GRAY_DARK : COLUPF = GRAY_LIGHT
  if color_cycle = 2 then COLUBK = GREEN_DARK : COLUPF = GREEN_LIGHT
  if color_cycle = 3 then COLUBK = ORANGE_DARK : COLUPF = ORANGE_LIGHT
  if color_cycle = 4 then COLUBK = PURPLE_DARK : COLUPF = PURPLE_LIGHT
  if color_cycle = 5 then COLUBK = GOLD_DARK : COLUPF = GOLD_LIGHT
  if color_cycle = 6 then COLUBK = BRICK_DARK : COLUPF = BRICK_LIGHT
  if color_cycle = 7 then COLUBK = OLIVE_DARK : COLUPF = OLIVE_LIGHT
  if color_cycle = 8 then COLUBK = TEAL_DARK : COLUPF = TEAL_LIGHT
  COLUP0 = BLUE
  COLUP1 = PINK
  goto _title_music_loop
_after_victory_music
  drawscreen
  goto mainloop

_title_loop
  if joy0fire || joy1fire then goto _start_game
  goto _title_music_loop
_after_title_music
  COLUP0 = BLUE
  COLUP1 = PINK
  drawscreen
  goto mainloop

_start_game
  AUDV0 = 0 : AUDV1 = 0
  game_state = STATE_PLAY
  game_over = 0
  color_cycle = 0
  color_cycle_timer = 0
  score = 0
  score_frame_counter = 0
  scorecolor = SCORE_COLOR
  p1_room_number = ROOM_RIGHT
  p0_room_number = ROOM_RIGHT
  player1x = START_P1_X
  player1y = START_P1_Y
  p1_y = START_P1_Y
  player0x = START_P0_X
  player0y = START_P0_Y
  p0_y = START_P0_Y
  missile0x = START_M0_X
  missile0y = START_M0_Y
  missile1x = START_M1_X
  missile1y = START_M1_Y
  goto _inititial_game_room bank2


_title_screen
  mi_room_number = 0
  COLUBK = BLACK
  COLUPF = WHITE
  scorecolor = BLACK
  playfield:
    ....XXX..XXX.XXX.XXX.X.X.XXX....
    ....X..X.X...X...X...X.X.X......
    ....XXX..XXX.XXX.X...X.X.XX.....
    ....X..X.X.....X.X...X.X.X......
    ....X..X.XXX.XXX.XXX.XXX.XXX....
    ................................
    ......XXX.XXX.XXX..XXX..........
    .......X..X...X..X.X..X.X.......
    .......X..XX..XXX..XXX..X.......
    .......X..X...X..X.X..X.X.......
    .......X..XXX.X..X.X..X.X.......
end
 title_music_setup_mode = TITLE_MUSIC_SETUP_INIT
 title_melody_phrase = 0
 goto _title_bass_setup

_title_music_loop
  title_bass_duration = title_bass_duration - 1
  if title_bass_duration then goto _after_title_bass

_read_title_bass_event
  temp4 = sread(_Title_Bass)
  if temp4 = 255 then title_music_setup_mode = TITLE_MUSIC_SETUP_BASS : goto _title_bass_setup
  if temp4 then goto _title_bass_note
  AUDV1 = 0
  title_bass_duration = 4
  goto _after_title_bass

_title_bass_note
  AUDV1 = 8
  AUDF1 = temp4
  title_bass_duration = 28
  goto _after_title_bass

_after_title_bass
  title_melody_duration = title_melody_duration - 1
  if title_melody_duration then goto _after_title_melody

_read_title_melody_event
  temp4 = sread(_Title_Melody)
  if temp4 = 255 && game_over then title_music_setup_mode = TITLE_MUSIC_SETUP_MELODY : goto _select_game_over_melody
  if temp4 = 255 then goto _next_title_melody_phrase
  temp5 = sread(_Title_Melody)
  temp6 = sread(_Title_Melody)
  AUDV0 = temp4
  AUDC0 = temp5
  AUDF0 = temp6
  title_melody_duration = sread(_Title_Melody)
  goto _after_title_melody

_next_title_melody_phrase
  title_melody_phrase = title_melody_phrase + 1
  if title_melody_phrase > 15 then title_melody_phrase = 0
  title_music_setup_mode = TITLE_MUSIC_SETUP_MELODY
  if title_melody_phrase > 11 then goto _title_melody_3_setup
  if title_melody_phrase > 7 then goto _title_melody_setup
  if title_melody_phrase > 3 then goto _title_melody_2_setup
  goto _title_melody_setup

_after_title_melody
  if game_over then goto _after_victory_music
  goto _after_title_music

_title_bass_setup
  sdata _Title_Bass = u
  ; Exact bass pitches with explicit rests. Playback code supplies the
  ; fixed 28-frame note and 4-frame rest timing so the audible line stays
  ; unchanged without needing extra state.
  ; G
  26
  0
  17
  0
  26
  0
  17
  0
  ; C
  19
  0
  26
  0
  19
  0
  26
  0
  ; G
  26
  0
  17
  0
  26
  0
  17
  0
  ; C
  17
  0
  23
  0
  17
  0
  23
  0
  255
end
  AUDV1 = 0
  AUDC1 = 12
  title_bass_duration = 1
  if title_music_setup_mode = TITLE_MUSIC_SETUP_INIT && game_over then goto _select_game_over_melody
  if title_music_setup_mode = TITLE_MUSIC_SETUP_INIT then goto _title_melody_setup
  goto _read_title_bass_event

_select_game_over_melody
  if easter_egg_found then goto _easter_egg_melody_setup
  goto _victory_melody_setup

_title_melody_setup
