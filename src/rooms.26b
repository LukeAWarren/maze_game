; temple room
_room_bottom_left
  p1_gate_transfer = 0
  if mi_room_number = ROOM_BOTTOM then missile0x = ENTRY_GATE_RIGHT_X
  if mi_room_number = ROOM_BOTTOM then missile1x = ENTRY_GATE_RIGHT_X
  if mi_room_number = ROOM_BOTTOM && p1_room_number = ROOM_BOTTOM && player1y <> OFFSCRN_Y && player1x <= P1_FOLLOW_LEFT_X then p1_gate_transfer = P1_EXIT_LEFT
  if mi_room_number = ROOM_HIDDEN then missile0x = ENTRY_GATE_LEFT_X
  if mi_room_number = ROOM_HIDDEN then missile1x = ENTRY_GATE_LEFT_X
  if mi_room_number = ROOM_HIDDEN && p1_room_number = ROOM_HIDDEN && player1y <> OFFSCRN_Y && player1x >= P1_FOLLOW_RIGHT_X then p1_gate_transfer = P1_EXIT_RIGHT
  gosub _check_p1_exit
  mi_room_number = ROOM_BOTTOM_LEFT
  COLUBK = ORANGE_DARK
  COLUPF = ORANGE_LIGHT
  playfield:
    XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
    X........................X......
    X....XX.........XXXXXX...X..XXXX
    X..XXXXXX.......X.....XX...X....
    X.X..XX..X.....X.......XXXX..XXX
    XX........X.....X..XXX.......X..
    XX........X....X.....XXXXXXXXXXX
    XX...XX...X....X................
    XX..XXXX..X....XXXXXXXXXXXXXXXXX
    XX.XXXXXX.......................
    XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
end
  if easter_egg_found then gosub _open_hidden_passage
  goto _finish_room_change

; treasure room
_room_hidden
  p1_gate_transfer = 0
  if mi_room_number = ROOM_BOTTOM_LEFT then missile0x = ENTRY_GATE_RIGHT_X
  if mi_room_number = ROOM_BOTTOM_LEFT then missile1x = ENTRY_GATE_RIGHT_X
  if mi_room_number = ROOM_BOTTOM_LEFT && p1_room_number = ROOM_BOTTOM_LEFT && player1y <> OFFSCRN_Y && player1x <= P1_FOLLOW_LEFT_X then p1_gate_transfer = P1_EXIT_LEFT
  gosub _check_p1_exit
  mi_room_number = ROOM_HIDDEN
  COLUBK = BLACK
  COLUPF = GOLD_LIGHT
  playfield:
    XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
    X..............................X
    X..................XX.....XX...X
    X...................XXXXXXX....X
    X...X.......X...XXX..XXXXX.....X
    X...X.......X.X.X.....XXX......X
    X...X...X.X.XX..XX.....X.......X
    X...X...X.X.X.X.X......X........
    X...XXX.XXX.X.X.XXX...XXX.......
    X..............................X
    XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
end
  goto _finish_room_change

_room_bottom_right
  p1_gate_transfer = 0
  if mi_room_number = ROOM_BOTTOM then missile0x = ENTRY_GATE_LEFT_X
  if mi_room_number = ROOM_BOTTOM then missile1x = ENTRY_GATE_LEFT_X
  if mi_room_number = ROOM_BOTTOM && p1_room_number = ROOM_BOTTOM && player1y <> OFFSCRN_Y && player1x >= P1_FOLLOW_RIGHT_X then p1_gate_transfer = P1_EXIT_RIGHT
  if mi_room_number = ROOM_RIGHT then missile0y = ENTRY_GATE_TOP_Y
  if mi_room_number = ROOM_RIGHT then missile1y = ENTRY_GATE_TOP_Y
  if mi_room_number = ROOM_RIGHT && p1_room_number = ROOM_RIGHT && player1y <> OFFSCRN_Y && player1y >= P1_FOLLOW_BOT_Y then p1_gate_transfer = P1_EXIT_DOWN
  gosub _check_p1_exit
  mi_room_number = ROOM_BOTTOM_RIGHT
  COLUBK = TEAL_DARK
  COLUPF = TEAL_LIGHT
  playfield:
