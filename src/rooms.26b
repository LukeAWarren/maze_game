; temple room
_room_bottom_left
  if mi_room_number = ROOM_BOTTOM then missile0x = ENTRY_GATE_RIGHT_X
  if mi_room_number = ROOM_BOTTOM then missile1x = ENTRY_GATE_RIGHT_X
  p1_gate_transfer = 0
  if mi_room_number = ROOM_BOTTOM && p1_room_number = ROOM_BOTTOM && player1y <> OFFSCRN_Y && player1x <= ENTRY_GATE_LEFT_X - P1_GATE_THRESHOLD then p1_gate_transfer = 1
  if p1_gate_transfer then player1x = ENTRY_GATE_RIGHT_X - P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_BOTTOM_LEFT
  if mi_room_number = ROOM_HIDDEN then missile0x = ENTRY_GATE_LEFT_X
  if mi_room_number = ROOM_HIDDEN then missile1x = ENTRY_GATE_LEFT_X
  p1_gate_transfer = 0
  if mi_room_number = ROOM_HIDDEN && p1_room_number = ROOM_HIDDEN && player1y <> OFFSCRN_Y && player1x >= ENTRY_GATE_RIGHT_X then p1_gate_transfer = 1
  if p1_gate_transfer then player1x = ENTRY_GATE_LEFT_X + P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_BOTTOM_LEFT
  mi_room_number = ROOM_BOTTOM_LEFT
  COLUBK = OLIVE_DARK
  COLUPF = OLIVE_LIGHT
