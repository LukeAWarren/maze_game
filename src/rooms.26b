  if mi_room_number = ROOM_TOP then missile0x = ENTRY_GATE_LEFT_X
  if mi_room_number = ROOM_TOP then missile1x = ENTRY_GATE_LEFT_X
  if mi_room_number = ROOM_TOP && p1_room_number = ROOM_TOP && player1y <> OFFSCRN_Y && player1x >= P1_FOLLOW_RIGHT_X then p1_gate_transfer = P1_EXIT_RIGHT
