  if mi_room_number = ROOM_TOP then missile1x = ENTRY_GATE_RIGHT_X
  if mi_room_number = ROOM_TOP && p1_room_number = ROOM_TOP && player1y <> OFFSCRN_Y && player1x <= P1_FOLLOW_LEFT_X then p1_gate_transfer = P1_EXIT_LEFT
  if mi_room_number = ROOM_LEFT then missile0y = ENTRY_GATE_BOT_Y
  if mi_room_number = ROOM_LEFT then missile1y = ENTRY_GATE_BOT_Y
  if mi_room_number = ROOM_LEFT && p1_room_number = ROOM_LEFT && player1y <> OFFSCRN_Y && player1y <= P1_FOLLOW_TOP_Y then p1_gate_transfer = P1_EXIT_UP
