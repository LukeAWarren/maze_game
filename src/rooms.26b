  goto _end_boundary_check bank1

; treasure room
_room_hidden
  if mi_room_number = ROOM_BOTTOM_LEFT then missile0x = ENTRY_GATE_RIGHT_X
  if mi_room_number = ROOM_BOTTOM_LEFT then missile1x = ENTRY_GATE_RIGHT_X
  p1_gate_transfer = 0
  if mi_room_number = ROOM_BOTTOM_LEFT && p1_room_number = ROOM_BOTTOM_LEFT && player1y <> OFFSCRN_Y && player1x <= ENTRY_GATE_LEFT_X - P1_GATE_THRESHOLD then p1_gate_transfer = 1
  if p1_gate_transfer then player1x = ENTRY_GATE_RIGHT_X - P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_HIDDEN
  mi_room_number = ROOM_HIDDEN
