_room_top
  if mi_room_number = ROOM_MIDDLE then missile0y = ENTRY_GATE_BOT_Y
  if mi_room_number = ROOM_MIDDLE then missile1y = ENTRY_GATE_BOT_Y
  p1_gate_transfer = 0
  if mi_room_number = ROOM_MIDDLE && p1_room_number = ROOM_MIDDLE && player1y <> OFFSCRN_Y && player1y <= ENTRY_GATE_TOP_Y + P1_GATE_THRESHOLD then p1_gate_transfer = 1
  if p1_gate_transfer then player1y = ENTRY_GATE_BOT_Y - P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_TOP
  if mi_room_number = ROOM_TOP_LEFT then missile0x = ENTRY_GATE_LEFT_X
  if mi_room_number = ROOM_TOP_LEFT then missile1x = ENTRY_GATE_LEFT_X
  p1_gate_transfer = 0
  if mi_room_number = ROOM_TOP_LEFT && p1_room_number = ROOM_TOP_LEFT && player1y <> OFFSCRN_Y && player1x >= ENTRY_GATE_RIGHT_X then p1_gate_transfer = 1
  if p1_gate_transfer then player1x = ENTRY_GATE_LEFT_X + P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_TOP
  if mi_room_number = ROOM_TOP_RIGHT then missile0x = ENTRY_GATE_RIGHT_X
  if mi_room_number = ROOM_TOP_RIGHT then missile1x = ENTRY_GATE_RIGHT_X
  p1_gate_transfer = 0
  if mi_room_number = ROOM_TOP_RIGHT && p1_room_number = ROOM_TOP_RIGHT && player1y <> OFFSCRN_Y && player1x <= ENTRY_GATE_LEFT_X - P1_GATE_THRESHOLD then p1_gate_transfer = 1
  if p1_gate_transfer then player1x = ENTRY_GATE_RIGHT_X - P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_TOP
  mi_room_number = ROOM_TOP
  COLUBK = GREEN_DARK
  COLUPF = GREEN_LIGHT
  playfield:
    XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
    ................................
    XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
    X...............................
    ...XXXXXXXXXXXXXXXXXXXXXXXXXXXXX
    XXXX............................
    ................XXXXXXXXXXXXXXXX
    ................X...............
    X...............X..XXXXXXXXXXXXX
