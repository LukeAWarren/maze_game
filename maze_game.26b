  if p1_gate_transfer then player1x = ENTRY_GATE_LEFT_X + P1_GATE_THRESHOLD
  if p1_gate_transfer then p1_room_number = ROOM_MIDDLE
  if mi_room_number = ROOM_TOP then missile0y = ENTRY_GATE_TOP_Y
  if mi_room_number = ROOM_TOP then missile1y = ENTRY_GATE_TOP_Y
